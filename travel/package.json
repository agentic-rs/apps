{
  "name": "apell-travel",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun scripts/link-sdk.ts && bun install",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "bun test",
    "test:ui": "bun run build && bun scripts/smoke.ts",
    "test:native": "bun run build && bun scripts/native-smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "bun run check && vite build",
    "pack": "bun run build && bun scripts/pack.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@apell/sdk": "file:./.apell-sdk",
    "leaflet": "1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/leaflet": "1.9.20",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "6.2.7",
    "playwright-core": "1.59.1",
    "prettier": "3.6.2",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  }
}
